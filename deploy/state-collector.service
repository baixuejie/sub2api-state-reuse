[Unit]
Description=Sub2API STATE collection cycle
After=network-online.target docker.service
[Service]
Type=oneshot
WorkingDirectory=/opt/sub2api-state-reuse/collector
EnvironmentFile=/etc/sub2api-state-reuse/config.env
ExecStart=/usr/bin/python3 /opt/sub2api-state-reuse/collector/state-cron.py
TimeoutStartSec=270
UMask=0077
