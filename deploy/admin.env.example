# Use a dedicated local file; do not source your host application's .env.
# Recommended: generate an admin API key in the host's settings and paste it
# into your private copy of this file. Never commit the completed file.
ADMIN_API_KEY=REPLACE_WITH_YOUR_ADMIN_API_KEY

# Alternative password login, if the host permits unattended authentication:
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=REPLACE_WITH_YOUR_ADMIN_PASSWORD
