[Unit]
Description=Gate Sub2API business scheduling on verified Astra tickets
After=network-online.target docker.service
[Service]
Type=oneshot
WorkingDirectory=/opt/sub2api-state-reuse/collector
EnvironmentFile=/etc/sub2api-state-reuse/config.env
ExecStart=/usr/bin/python3 /opt/sub2api-state-reuse/collector/scheduling.py
TimeoutStartSec=45
UMask=0077
