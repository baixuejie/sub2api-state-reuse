# Host paths. Never point STATE_ROOT at a Git checkout.
STATE_ROOT=/var/lib/sub2api-state-reuse
STATE_TICKET_STORE=/srv/sub2api/data/fn-state-reuse/tickets.json
SUB2API_BASE_URL=http://127.0.0.1:8081/api/v1
SUB2API_ENV_FILE=/etc/sub2api-state-reuse/admin.env
SUB2API_PG_CONTAINER=sub2api-postgres
STATE_PLUGIN_ID=1
STATE_READY_GROUP=不降智分组
STATE_FALLBACK_GROUP=降智分组
STATE_ROUTES_FILE=/etc/sub2api-state-reuse/routes.json
# Optional rotating HTTP proxy generators; 0600, see README for the format.
#STATE_DYNAMIC_PROXY_GENERATORS_FILE=/etc/sub2api-state-reuse/dynamic-proxy-generators.json
STATE_PLUGIN_UID=1000
STATE_PLUGIN_GID=1000
STATE_MONITOR_PORT=17843
STATE_MONITOR_HOST=127.0.0.1

# v1 host automation. Update the plugin ID above to the installed plugin.
STATE_ACCOUNT_SCOPE=plugin
STATE_PROXY_SOURCE=plugin
STATE_AUTO_GROUP=false
STATE_TICKET_SCHEDULING=true
STATE_AUTO_ENROLL=true
# Probe both Astra and Sol, but keep account scheduling dependent on Astra.
STATE_REQUIRED_MODELS=gpt-6-astra
