# Host paths. Never point STATE_ROOT at a Git checkout.
STATE_ROOT=/var/lib/sub2api-state-reuse
STATE_TICKET_STORE=/srv/sub2api/data/fn-state-reuse/tickets.json
SUB2API_BASE_URL=http://127.0.0.1:8081/api/v1
SUB2API_ENV_FILE=/etc/sub2api-state-reuse/admin.env
SUB2API_PG_CONTAINER=sub2api-postgres
STATE_PLUGIN_ID=2
STATE_READY_GROUP=不降智分组
STATE_FALLBACK_GROUP=降智分组
STATE_ROUTES_FILE=/etc/sub2api-state-reuse/routes.json
STATE_PLUGIN_UID=1000
STATE_PLUGIN_GID=1000
STATE_MONITOR_PORT=17843
